# inFlow AI environment configuration
# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit your real secrets.
#
# 非敏感应用参数（日志、Token 有效期、截图参数等）见：
#   03-src/backend/app/core/config.py

# ── Database ─────────────────────────────────────────────
# Used by docker-compose. Change DB password before exposing to network.
POSTGRES_PASSWORD=change_me_to_a_strong_password

# ── JWT secret ───────────────────────────────────────────
# Used to sign login + sync tokens. CHANGE THIS in production —
# anyone with the secret can forge tokens for any user.
SECRET_KEY=change_me_to_a_random_secret_at_least_32_chars

# ── Optional: LLM / Embedding API keys ──
# 推荐在 .env 配置；也可在网页「设置」中修改（会写入 config_store.json，优先级更高）。
#
# MINIMAX_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# DASHSCOPE_API_KEY=

# 硅基流动（LLM 与 Embedding 可共用同一 Key）
# SILICONFLOW_API_KEY=sk-...
# EMBEDDING_API_KEY=   # 可选，未设置时复用 SILICONFLOW_API_KEY
# Embedding 服务商/模型等非敏感项见 03-src/backend/app/core/config.py

# ── Optional: server-to-server service tokens ────────────
# Format: "tokenA:usernameA,tokenB:usernameB"
# Used by trusted internal callers (e.g. the wechat bot worker).
# Leave empty if you don't run wechat bot integration.
SERVICE_TOKENS=

# ── Optional: per-service tokens (referenced by wechat-bot etc.) ──
SERVICE_TOKEN_WECHAT_BOT=

# ── Optional: Xiaohongshu cookie ────────────────────────────
# XHS_COOKIE=
