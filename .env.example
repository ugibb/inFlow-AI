# inFlow AI — 环境变量配置模板
# 用法：cp .env.example .env，然后按注释填写。 .env 已 gitignore，勿提交。
#
# Docker 部署：docker compose 读取项目根目录的 .env，并通过 env_file 注入 backend / wechat-bot。
# 本地开发：./start-local.sh 同样读取项目根目录 .env。
#
# 配置优先级（LLM / Embedding）：
#   网页「设置」config_store.json  >  .env  >  config.py 默认值

# ══════════════════════════════════════════════════════════
# 一、必填（Docker 启动依赖，缺一会报错或无法登录）
# ══════════════════════════════════════════════════════════

# 数据库密码（docker-compose 创建 postgres 容器时使用；首次部署后勿随意修改，否则与已有数据卷不一致）
POSTGRES_PASSWORD=change_me_to_a_strong_password

# JWT 签名密钥（登录 Token；生产环境必须改为随机长字符串，≥32 字符）
SECRET_KEY=change_me_to_a_random_secret_at_least_32_chars

# ══════════════════════════════════════════════════════════
# 二、强烈建议（生产体验明显更好）
# ══════════════════════════════════════════════════════════

# 播客/视频 ASR 转录（小宇宙等长音频）
# ASR_PROVIDER=tingwu（默认，国内腾讯云）| groq（海外/本地，需可访问 Groq API）
ASR_PROVIDER=tingwu

# Groq Whisper（ASR_PROVIDER=groq 时必填）
# 申请：https://console.groq.com/
GROQ_API_KEY=

# 通义听悟（ASR_PROVIDER=tingwu 时必填）
# 控制台：https://nls-portal.console.aliyun.com/tingwu/overview
TINGWU_APP_KEY=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
TINGWU_OSS_BUCKET=
TINGWU_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
# TINGWU_SOURCE_LANGUAGE=cn
# TINGWU_POLL_INTERVAL_SEC=30
# TINGWU_MAX_WAIT_SEC=10800

# 硅基流动 — LLM 对话 + Embedding 语义搜索（可共用同一 Key）
# 申请：https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=

# 公网访问地址（微信精华卡外链、部分回调 URL）
inFlow_PUBLIC_BASE=https://你的域名.com

# Pipeline 文件存储（Docker bind mount → 容器 /app/data）
# 本地：./03-src/server/data
# 宝塔生产：/www/data/inflow/pipeline（见 02-docs/20260702_09_Pipeline存储架构与实施路线.md）
INFLOW_PIPELINE_DATA_DIR=./03-src/server/data

# ══════════════════════════════════════════════════════════
# 本地 worker 分流（外部化 URL ingest 的完整 pipeline）
# ══════════════════════════════════════════════════════════
# true：URL ingest 的 job 置 external_processing=true，云端只登记不处理，
#       由本地 worker（start-worker.sh，连接本库 5432）承接完整 pipeline。
#       开启前务必确认本地 worker 已部署运行，否则新 URL 会永久停在 pending。
# false（默认）：云端自行处理 URL（腾讯云无法访问 Groq，ASR 将 403）。
#   注意：腾讯云生产若同时跑云端 pipeline 与本地 worker，必须在此显式设 true。
EXTERNAL_PROCESSING=false

# 登录 Token 有效期（天）；30=一个月，0=近似永久（仅自建）
ACCESS_TOKEN_EXPIRE_DAYS=30

# ══════════════════════════════════════════════════════════
# 三、微信 Bot（宝塔 deploy-baota.sh 可自动生成 token）
# ══════════════════════════════════════════════════════════

# Bot 调用 backend 的服务令牌（deploy-baota.sh 未配置时会自动生成）
SERVICE_TOKEN_WECHAT_BOT=

# 格式：token:用户名,token2:用户名2 ；须包含上面的 wechat bot token 映射到超管
# 示例（token 与上行相同）：abc123...:weaiw
SERVICE_TOKENS=

# Bot 以哪个用户身份代操作（默认超管 weaiw）
WECHAT_BOT_ACT_AS_USER=weaiw

# ══════════════════════════════════════════════════════════
# 四、可选 LLM（按你实际使用的服务商填写，可只在网页「设置」里配）
# ══════════════════════════════════════════════════════════

# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# MINIMAX_API_KEY=
# DASHSCOPE_API_KEY=
# GROQ_API_KEY=          # 已在第二节
# EMBEDDING_API_KEY=     # 未设置时复用 SILICONFLOW_API_KEY

# Embedding 服务商/模型等非敏感项见：03-src/core/inflow_core/core/config.py

# ══════════════════════════════════════════════════════════
# 五、可选采集增强
# ══════════════════════════════════════════════════════════

# 小红书 Cookie（抓取小红书链接时需要）
# XHS_COOKIE=

# 飞书文档 Cookie
# FEISHU_COOKIE=

# CORS 额外来源（逗号分隔；一般反向代理同域无需改）
# ALLOWED_ORIGINS=https://你的域名.com
