# inFlow AI — 环境变量配置模板（云端 backend / wechat-bot）
# 用法：cp .env.example .env，然后按注释填写。 .env 已 gitignore，勿提交。
#
# 本文件仅含「云端单元」所需配置。采集/转录/parse 等重计算由本地 worker 承接，
# 其 ASR、采集 Cookie 等配置在独立仓库 ugibb/inflow-worker（本文件不含）。
#
# 配置优先级（LLM / Embedding）：
#   网页「设置」config_store.json  >  .env  >  config.py 默认值

# ══════════════════════════════════════════════════════════
# 一、必填（缺一会报错或无法登录）
# ══════════════════════════════════════════════════════════

# 数据库密码（docker-compose 创建 postgres 容器时使用；start-server.sh 首次运行
# 会自动生成真实密码并写入 .env）。backend 连接串由代码按 POSTGRES_* 组件自动拼
# （user/host/port/db 有默认值，无需配置），不再需要手动配 DATABASE_URL。
POSTGRES_PASSWORD=change_me_to_a_strong_password

# JWT 签名密钥（登录 Token；生产环境必须改为随机长字符串，≥32 字符）
SECRET_KEY=change_me_to_a_random_secret_at_least_32_chars

# ══════════════════════════════════════════════════════════
# 二、强烈建议（生产体验明显更好）
# ══════════════════════════════════════════════════════════

# 硅基流动 — LLM 对话 + Embedding 语义搜索（云端 RAG 问答 / 知识检索核心，可共用同一 Key）
# 申请：https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=

# 公网访问地址（微信精华卡外链、部分回调 URL）
inFlow_PUBLIC_BASE=https://你的域名.com

# Pipeline 文件存储（云端只做收件暂存，重计算由 worker 拉取）
# 本地：./03-src/backend/data
# 宝塔生产：/www/data/inflow/pipeline（启动脚本自动设置）
INFLOW_PIPELINE_DATA_DIR=./03-src/backend/data

# 登录 Token 有效期（天）；30=一个月，0=近似永久（仅自建）
ACCESS_TOKEN_EXPIRE_DAYS=30

# ══════════════════════════════════════════════════════════
# 本地 worker 分流（url/upload/paste 三入口全量外部化）
# ══════════════════════════════════════════════════════════
# true（默认）：三入口的 job 全部置 external_processing=true，云端只登记
#       （upload/paste 收件落盘 data/00_staging/ 等 worker 拉取），
#       由本地 worker（start-worker.sh，连接本库 5432）承接完整 pipeline。
#       worker 未运行时新 job 停在 pending（前端可见），不会静默丢数据。
# false：仅限云端调试 —— 云端 venv 已做依赖瘦身（无 playwright/markitdown/
#       fastembed 等重依赖），关闭后三入口会 ImportError。
EXTERNAL_PROCESSING=true

# ══════════════════════════════════════════════════════════
# 云端观测告警（可选，默认开启）
# ══════════════════════════════════════════════════════════
# 兜住「worker 长时间失联无人知」：进度停滞>10min / 租约超时>10min /
# 日失败率>30% / worker 失联，命中写 backend 日志 WARNING/ERROR。
# 4 条 SELECT 每 OBSERVER_INTERVAL_SEC（秒）一次，轻量巡检；无需可关。
# OBSERVER_ENABLED=false
# OBSERVER_INTERVAL_SEC=300

# 免费额度配额（worker 契约 quota_check.sql）：免费 10 条/人/天。
# 「条」= 当日到 ready 的 ingest_jobs 数；登记新 job 时检查，超限返回 429。
# 0=不限制（自托管全部放开）。
# FREE_QUOTA_PER_DAY=10

# ══════════════════════════════════════════════════════════
# 三、微信 Bot（start-server.sh 首次运行可自动生成 token）
# ══════════════════════════════════════════════════════════

# Bot 调用 backend 的服务令牌（未配置时脚本自动生成）
SERVICE_TOKEN_WECHAT_BOT=

# 格式：token:用户名,token2:用户名2 ；须包含上面的 wechat bot token 映射到超管
SERVICE_TOKENS=

# Bot 以哪个用户身份代操作（默认超管 weaiw）
WECHAT_BOT_ACT_AS_USER=weaiw

# ══════════════════════════════════════════════════════════
# 三之二、微信小程序「微信一键登录」
# （方案：02-docs/20260905_微信小程序微信登录方案.md）
# ══════════════════════════════════════════════════════════

# AppID 非敏感（config.py 已兜底正式号）；AppSecret 必填
# mp.weixin.qq.com → 开发管理 → 开发设置 → 生成 AppSecret（管理员扫码）
# 若该页开了「IP 白名单」，需加入服务器出口 IP
WECHAT_APPID=wxe091ce737f45cacc
WECHAT_SECRET=

# openid 绑定到哪个账号（空 = 自动取第一个超管；库主账号用户名）
WECHAT_BIND_USERNAME=

# 首次绑定邀请码（空 = 免验直进，体验版分发默认；公开上架时必须设置）
WECHAT_INVITE_CODE=

# ══════════════════════════════════════════════════════════
# 四、可选 LLM 兜底（按你实际使用的服务商填写；也可只在网页「设置」里配）
# ══════════════════════════════════════════════════════════
# 支持厂商见 03-src/backend/core/config_manager.py：
#   DEEPSEEK_API_KEY / OPENAI_API_KEY / SILICONFLOW_API_KEY / MINIMAX_API_KEY
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# MINIMAX_API_KEY=
# EMBEDDING_API_KEY=     # 未设置时复用 SILICONFLOW_API_KEY

# Embedding 服务商/模型等非敏感项见：03-src/backend/core/config.py

# ══════════════════════════════════════════════════════════
# 五、CORS（一般反向代理同域无需改）
# ══════════════════════════════════════════════════════════

# 额外来源（逗号分隔）
# ALLOWED_ORIGINS=https://你的域名.com
