# inFlow 本地 worker 配置模板
# 复制到 03-src/worker/.env.local-worker（worker 读取该路径），填入真实值后启动：
#   cp deploy/worker/.env.local-worker.example 03-src/worker/.env.local-worker
# 文档：02-docs/20260819_11_本地Worker重构方案.md（第六节）、02-docs/20260820_12_本地Worker部署实操指南.md

# ── 任务总线：云端 PostgreSQL（5432 白名单仅放行本机 IP）──
DATABASE_URL=postgresql+asyncpg://inflow:<POSTGRES_PASSWORD>@<云端公网IP>:5432/inflow

# ── PNG 回传：SFTP 直传云端 pipeline 目录（复用 SSH 22，无需新开 API/FTP）──
SFTP_HOST=<云端公网IP>
SFTP_USER=inflow_worker
SFTP_PORT=22
SFTP_PIPELINE_DIR=/www/data/inflow/pipeline

# ── ASR / LLM：本地可自由访问外网，按需选择 ──
ASR_PROVIDER=groq                  # groq / siliconflow / tingwu / faster-whisper
GROQ_API_KEY=<Groq Key>
SILICONFLOW_API_KEY=<SiliconFlow Key，LLM/embedding 复用>

# ── 可选：渠道采集增强 ──
# XHS_COOKIE=<小红书 Cookie>
# FEISHU_COOKIE=<飞书 Cookie>
