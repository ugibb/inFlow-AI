.page {
  padding: 24rpx 24rpx 0;
}

/* ── 加载骨架 ── */
.read-loading {
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--border);
  padding: 24rpx;
}
.rl-cover {
  height: 320rpx;
  border-radius: 14rpx;
  background: #ececf0;
  margin-bottom: 24rpx;
}
.rl-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: #ececf0;
  margin-top: 18rpx;
}
.rl-w90 { width: 90%; }
.rl-w80 { width: 80%; }
.rl-w70 { width: 70%; }
.rl-w60 { width: 60%; }
.rl-w50 { width: 50%; }

/* ── 游客引导条 ── */
.guest-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
}
.guest-bar-text {
  font-size: 24rpx;
  color: var(--text-2, #86868b);
}
.guest-bar-cta {
  font-size: 24rpx;
  font-weight: 600;
  color: #007aff;
}

/* ── 头部 ── */
.head {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.head-cover {
  width: 100%;
  border-radius: 14rpx;
  display: block;
  margin-bottom: 20rpx;
  background: #f2f2f7;
}
.head-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.45;
  color: var(--text);
}
.head-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}
.head-chip {
  font-size: 22rpx;
  color: var(--accent);
  background: var(--accent-bg);
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
}
.head-meta-text {
  font-size: 22rpx;
  color: var(--text-3);
}
.head-author {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-2);
}
.head-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.head-actions {
  margin-top: 20rpx;
  display: flex;
}

/* ── Tab 条 ── */
.tabbar {
  width: 100%;
  white-space: nowrap;
  background: var(--bg);
  margin-bottom: 20rpx;
}
.tabbar-inner {
  display: inline-flex;
  gap: 44rpx;
  padding: 4rpx 8rpx;
}
.tab {
  position: relative;
  font-size: 29rpx;
  color: var(--text-3);
  padding: 10rpx 0 18rpx;
}
.tab:active {
  opacity: 0.7;
}
.tab-active {
  color: var(--text);
  font-weight: 700;
}
.tab-active::after {
  content: '';
  position: absolute;
  left: 25%;
  right: 25%;
  bottom: 4rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: var(--accent);
}

.tab-panel {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 24rpx;
}
.panel-loading {
  text-align: center;
  color: var(--text-3);
  font-size: 26rpx;
  padding: 48rpx 0;
}

/* ── 音频节目信息 ── */
.audio-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border);
  margin-bottom: 24rpx;
}
.audio-cover {
  width: 60%;
  border-radius: 16rpx;
  display: block;
  background: #f2f2f7;
}
.audio-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.audio-line {
  font-size: 26rpx;
  color: var(--text-2);
}
.audio-hint {
  font-size: 22rpx;
  color: var(--text-3);
}

.duration {
  display: block;
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 20rpx;
}

/* ── AI 摘要 ── */
.ai-card {
  margin-bottom: 24rpx;
}
.ai-card:last-child {
  margin-bottom: 0;
}
.ai-label {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--accent);
  background: var(--accent-bg);
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
  margin-bottom: 16rpx;
}
.ai-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.75;
  color: var(--text);
}
.kp {
  display: flex;
  gap: 14rpx;
  margin-top: 12rpx;
}
.kp-dot {
  color: var(--accent);
  font-weight: 700;
  flex-shrink: 0;
}
.kp-text {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--text-2);
}

/* ── 底部常驻播放条（音频内容）：贴底圆角卡片 —— 时间行 · 自绘细进度 · 控制行 ──
   与页面卡片语言一致：左右留白 + 上圆角下贴底 + 轻阴影；浅色主色适配
   （var(--text) 文字、#007aff 主蓝高亮、--text-3 次要）。 */
.player {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 0; /* 贴底停放：卡片下沿与屏幕底对齐 */
  z-index: 50;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 18rpx 28rpx 0;
  padding-bottom: calc(8rpx + env(safe-area-inset-bottom));
  background: var(--card, #fff);
  border: 1rpx solid var(--border);
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -4rpx 20rpx rgba(29, 29, 31, 0.06);
}
/* 行1 时间：当前(左) · -剩余(右)，等宽数字避免跳动 */
.player-time-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 0 2rpx 10rpx;
}
.pt-cur {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}
.pt-left {
  font-size: 22rpx;
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}
/* 行2 自绘细进度：整条作热区，轨道 6rpx 圆头、主蓝填充、白钮带轻影 */
.prog {
  position: relative;
  height: 44rpx;
  display: flex;
  align-items: center;
}
.prog-track {
  position: relative;
  width: 100%;
  height: 6rpx;
  border-radius: 999rpx;
  background: var(--border, #e5e5ea);
  overflow: hidden;
}
.prog-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 0;
  border-radius: 999rpx;
  background: var(--accent, #007aff);
}
.prog-knob {
  position: absolute;
  top: 50%;
  width: 24rpx;
  height: 24rpx;
  margin: -12rpx 0 0 -12rpx; /* 以百分比落点为圆心 */
  border-radius: 50%;
  background: #fff;
  border: 1rpx solid rgba(29, 29, 31, 0.08);
  box-shadow: 0 2rpx 8rpx rgba(29, 29, 31, 0.18);
}
/* 行3 控制：三键组居中（左右等宽占位）、倍速胶囊固定右端有内衬不贴边 */
.player-ctrl {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}
.ctrl-side {
  width: 128rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.ctrl-cluster {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ctrl-skip {
  width: 76rpx;
  height: 96rpx;
  margin: 0 18rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
/* 后退15/前进30 回环箭头图标（本地 PNG，规避 ↺/↻ 字体缺失） */
.ctrl-skip-ico {
  width: 72rpx;
  height: 72rpx;
  display: block;
}
/* 中央播放/暂停：主蓝实心圆钮 + 白色图标 */
.ctrl-play {
  width: 104rpx;
  height: 104rpx;
  margin: 0 18rpx;
  box-sizing: border-box;
  border-radius: 50%;
  background: var(--accent, #007aff);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(0, 122, 255, 0.28);
}
.ctrl-play-ico {
  width: 46rpx;
  height: 46rpx;
  display: block;
  margin-left: 3rpx; /* 三角视觉重心补偿 */
}
/* 倍速胶囊：点按循环切速；≠1x 主蓝高亮 */
.rate-pill {
  min-width: 84rpx;
  height: 52rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-2);
  background: var(--bg, #f5f5f7);
}
.rate-on {
  color: var(--accent);
  background: var(--accent-bg, #e8f2ff);
}
.tap-hover {
  opacity: 0.55;
}
.player-spacer {
  height: calc(250rpx + env(safe-area-inset-bottom));
}
