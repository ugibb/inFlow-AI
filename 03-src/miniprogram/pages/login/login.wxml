<view class="login-page">
  <view class="brand">
    <view class="brand-logo">in</view>
    <text class="brand-name">inFlow</text>
    <text class="brand-desc">你的私人知识库</text>
  </view>

  <view class="form">
    <view class="field">
      <text class="field-label">账号</text>
      <input
        class="field-input"
        placeholder="用户名"
        value="{{username}}"
        bindinput="onUsername"
      />
    </view>
    <view class="field">
      <text class="field-label">密码</text>
      <input
        class="field-input"
        placeholder="密码"
        password
        value="{{password}}"
        bindinput="onPassword"
        bindconfirm="onSubmit"
      />
    </view>

    <text wx:if="{{error}}" class="form-error">{{error}}</text>

    <button class="submit-btn {{submitting ? 'submit-btn-loading' : ''}}" bindtap="onSubmit" disabled="{{submitting}}">
      {{submitting ? '登录中…' : '登 录'}}
    </button>
  </view>

  <view class="footer">
    <text class="footer-text">与 Web 端使用同一账号</text>
    <text class="footer-server">{{serverUrl}}</text>
  </view>
</view>
