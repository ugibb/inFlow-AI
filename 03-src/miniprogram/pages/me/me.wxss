.me-page {
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
}

.user-card {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-bottom: 32rpx;
}
.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #007aff 0%, #0055cc 100%);
  color: #fff;
  font-size: 48rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.avatar-img {
  background: var(--bg);
}
.user-edit {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--accent);
  padding: 8rpx 0 8rpx 16rpx;
}

/* ── 编辑资料面板 ── */
.edit-panel {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.edit-avatar-btn {
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  line-height: 1.2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.edit-avatar-btn::after {
  border: none;
}
.edit-avatar-img,
.edit-avatar-placeholder {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  overflow: hidden;
}
.edit-avatar-placeholder {
  background: var(--bg);
  border: 1rpx dashed var(--border);
  color: var(--text-3);
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.edit-avatar-hint {
  font-size: 22rpx;
  color: var(--text-3);
}
.edit-field {
  width: 100%;
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.field-label {
  font-size: 22rpx;
  color: var(--text-3);
}
.edit-input {
  font-size: 30rpx;
  color: var(--text);
  min-height: 52rpx;
  border-bottom: 1rpx solid var(--border);
  padding-bottom: 8rpx;
}
.edit-actions {
  width: 100%;
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}
.edit-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.edit-btn-ghost {
  background: var(--bg);
  color: var(--text-2);
}
.edit-btn-primary {
  background: var(--accent);
  color: #fff;
  font-weight: 600;
}
.edit-btn:active {
  opacity: 0.85;
}
.edit-btn-loading {
  opacity: 0.6;
}
.user-info {
  flex: 1;
  min-width: 0;
}
.user-name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.user-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}
.user-badge {
  font-size: 20rpx;
  color: var(--accent);
  background: var(--accent-bg);
  border-radius: 999rpx;
  padding: 2rpx 16rpx;
}
.user-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.actions {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  overflow: hidden;
}
.action {
  padding: 30rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid var(--border);
}
.action:last-child {
  border-bottom: none;
}
.action:active {
  background: #f7f7fa;
}
.action-title {
  font-size: 28rpx;
  color: var(--text);
  flex-shrink: 0;
}
.action-value {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 22rpx;
  color: var(--text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.action-arrow {
  color: var(--text-3);
  font-size: 34rpx;
  margin-left: auto;
}
.action-danger .action-title {
  color: var(--danger);
}

.version {
  margin-top: auto;
  padding-top: 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3);
}
