/* 全局样式：iOS 风格浅色主题（变量对齐 Web 端 globals.css） */
page {
  --bg: #f5f5f7;
  --card: #ffffff;
  --text: #1d1d1f;
  --text-2: #48484a;
  --text-3: #8e8e93;
  --border: #e5e5ea;
  --accent: #007aff;
  --accent-bg: #e8f2ff;
  --danger: #ff3b30;
  --warning: #ff9500;

  background-color: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

/* 重置 button，使其可当普通元素排版 */
button {
  background: initial;
  padding: 0;
  margin: 0;
  line-height: inherit;
  font-size: inherit;
  border-radius: 0;
}
button::after {
  border: none;
}

/* 通用幽灵按钮（复制链接等次级操作） */
.btn-ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 28rpx;
  border-radius: 14rpx;
  background: var(--accent-bg);
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 500;
}
.btn-ghost:active {
  opacity: 0.75;
}

/* 通用标签 chip（卡片/详情页共用） */
.tag {
  display: inline-flex;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.6;
}

.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
