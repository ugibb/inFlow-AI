.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 48rpx;
  gap: 12rpx;
}
.empty-icon {
  font-size: 72rpx;
  margin-bottom: 8rpx;
}
.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-2);
  text-align: center;
}
.empty-desc {
  font-size: 24rpx;
  color: var(--text-3);
  text-align: center;
}
.empty-btn {
  margin-top: 24rpx;
  padding: 16rpx 64rpx;
  border-radius: 16rpx;
  background: var(--accent);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}
.empty-btn:active {
  opacity: 0.8;
}
