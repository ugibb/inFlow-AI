.md {
  font-size: 28rpx;
  line-height: 1.75;
  color: var(--text);
  word-break: break-word;
}

/* 标题 */
.h {
  display: block;
  font-weight: 700;
  color: var(--text);
  margin: 32rpx 0 16rpx;
}
.h:first-child {
  margin-top: 0;
}
.h1 { font-size: 38rpx; }
.h2 { font-size: 34rpx; }
.h3 { font-size: 32rpx; }
.h4 { font-size: 30rpx; }

/* 段落 */
.p {
  display: block;
  margin: 16rpx 0;
}

/* 行内样式 */
.seg-bold { font-weight: 700; }
.seg-italic { font-style: italic; }
.seg-code {
  background: #f2f2f7;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  font-family: Menlo, Consolas, monospace;
  font-size: 25rpx;
}
.seg-link {
  color: var(--accent);
  text-decoration: underline;
}

/* 图片 */
.md-img {
  width: 100%;
  border-radius: 12rpx;
  margin: 16rpx 0;
  display: block;
  background: #f2f2f7;
}

/* 列表 */
.list {
  margin: 16rpx 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.list-item {
  display: flex;
  gap: 14rpx;
}
.list-bullet {
  color: var(--accent);
  font-weight: 600;
  flex-shrink: 0;
  min-width: 34rpx;
}
.list-text {
  flex: 1;
  min-width: 0;
}

/* 引用 */
.quote {
  border-left: 6rpx solid var(--border);
  background: #f7f7fa;
  padding: 14rpx 20rpx;
  border-radius: 0 12rpx 12rpx 0;
  margin: 16rpx 0;
  color: var(--text-2);
}

/* 代码块 */
.codeblock {
  background: #f2f2f7;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  margin: 16rpx 0;
  overflow-x: auto;
}
.codeblock-lang {
  display: block;
  font-size: 20rpx;
  color: var(--text-3);
  margin-bottom: 8rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}
.codeblock-text {
  display: block;
  font-family: Menlo, Consolas, monospace;
  font-size: 24rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

/* 分隔线 */
.hr {
  height: 1rpx;
  background: var(--border);
  margin: 28rpx 0;
}
