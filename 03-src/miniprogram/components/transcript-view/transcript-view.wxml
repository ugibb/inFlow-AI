<view class="tl-wrap">
  <scroll-view
    class="tl-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    scroll-top="{{scrollTop}}"
    scroll-with-animation="{{scrollAnim}}"
    bindscroll="onScroll"
  >
    <!-- 虚拟列表：上下占位 + 窗口内 ~100 句 -->
    <view class="tl-inner">
      <view style="height: {{padTop}}px;" />
      <view
        wx:for="{{view}}"
        wx:key="ai"
        class="seg-item {{activeIdx === item.ai ? 'seg-active' : activeIdx > item.ai ? 'seg-past' : 'seg-idle'}}"
        data-ai="{{item.ai}}"
        bindtap="onTap"
      >
        <text class="seg-time {{activeIdx === item.ai ? 'seg-time-active' : ''}}">{{item.time}}</text>
        <text class="seg-text {{activeIdx === item.ai ? 'seg-text-active' : ''}}" user-select>{{item.text}}</text>
      </view>
      <view style="height: {{padBottom}}px;" />
    </view>
  </scroll-view>

  <!-- 上下渐隐遮罩 -->
  <view class="tl-fade tl-fade-top" />
  <view class="tl-fade tl-fade-bottom" />

  <!-- 手动滚动后的「返回播放位置」胶囊 -->
  <view wx:if="{{showPill}}" class="tl-pill" hover-class="tl-pill-hover" bindtap="onResumeFollow">↩ 返回播放位置</view>
</view>
