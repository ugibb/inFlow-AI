# inFlow AI 本地独立 worker 配置模板
# 用法：cp .env.local-worker.example .env.local-worker 并填入真实值
# start-worker.sh 会安全加载本文件（python-dotenv export，处理特殊字符）。

# ── 云端 PostgreSQL（任务总线，5432 安全组白名单放行本地 Mac 公网 IP）──
DATABASE_URL=postgresql+asyncpg://inflow:<POSTGRES_PASSWORD>@<云端公网IP>:5432/inflow

# ── 本地 ASR 选择（云端访问不了国外 AI，本地可自由选）──
# groq（Groq Whisper，推荐）| tingwu（通义听悟，长音频/数小时）| siliconflow | faster-whisper
ASR_PROVIDER=groq
GROQ_API_KEY=<Groq Key>
# LLM / embedding / SiliconFlow ASR 复用
SILICONFLOW_API_KEY=<SF Key>

# ── SFTP PNG 回传（云端不新增 API；复用 SSH 22 端口公钥鉴权）──
# SFTP_PIPELINE_DIR 必须与云端 INFLOW_PIPELINE_DATA_DIR 一致（绝对路径）
SFTP_HOST=<云端公网IP>
SFTP_USER=inFlow_worker
SFTP_PORT=22
SFTP_PIPELINE_DIR=/www/data/inflow/pipeline

# ── 调度（可选，有默认值）──
# SCAN_INTERVAL_S=10
# LEASE_SECONDS=600
# HEARTBEAT_INTERVAL_S=120
